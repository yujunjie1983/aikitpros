{
  "version": 2,
  "buildCommand": "yarn build && (cd public && cp landing.html landing-zh.html demo.html pricing.html competition.html og-competition.svg ../dist/)",  "installCommand": "yarn",
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "(www\\.)?aikitpros\\.cn" }], "destination": "/landing-zh.html", "permanent": false },
    { "source": "/landing.html", "has": [{ "type": "host", "value": "(www\\.)?aikitpros\\.cn" }], "destination": "/landing-zh.html", "permanent": false },
        { "source": "/pricing.html", "has": [{ "type": "host", "value": "(www\\.)?aikitpros\\.cn" }], "destination": "/landing-zh.html", "permanent": false },
    { "source": "/demo.html", "has": [{ "type": "host", "value": "(www\\.)?aikitpros\\.cn" }], "destination": "/landing-zh.html", "permanent": false },
    { "source": "/competition.html", "has": [{ "type": "host", "value": "(www\\.)?aikitpros\\.cn" }], "destination": "/landing-zh.html", "permanent": false },
    { "source": "/", "destination": "/landing.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!landing.html|landing-zh.html|demo.html|pricing.html|competition.html|og-competition.svg|api|assets|favicon.ico|robots.txt|sitemap.xml|llms.txt).*)", "destination": "/index.html" }
  ]
}
